generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  CATALOG_MANAGER
  USER_MANAGER
  ORDER_MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StoreIndustry {
  GOLD
  GENERAL
}

enum AdminTemplate {
  CLASSIC
  BLUEPRINT
}

enum ProductDiscountType {
  PERCENT
  FIXED
}

enum OptionKind {
  SELECT
  COLOR
}

enum ProductReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductReviewReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum PromotionType {
  COUPON
  FREE_SHIPPING
  NEXT_PURCHASE
  FIRST_PURCHASE
}

enum PromotionDiscountType {
  PERCENT
  FIXED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaScope {
  CATEGORY
  PRODUCT
  HOMEPAGE
  /// The store's own visual identity (logo, favicon, social image) — see `StoreSetting`'s
  /// `brand*` fields. Not the same thing as `PRODUCT_BRAND`, a manufacturer a product is made by.
  BRAND
  /// A product manufacturer's own logo (Samsung, Xiaomi, …) — kept apart from `BRAND`, which is
  /// the store's own identity, not a product's.
  PRODUCT_BRAND
}

enum OrderStatus {
  PENDING_PAYMENT
  EXPIRED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderExpirationStart {
  CREATED_AT
  PAYMENT_STARTED_AT
}

enum OrderExpirationAction {
  EXPIRE
  CANCEL
  NOTIFY
}

enum DeliveryMethod {
  INSURED_SHIPPING
  STORE_PICKUP
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  ISSUED
  VOID
}

enum AddressType {
  SHIPPING
  BILLING
}

enum AddressRecipientType {
  SELF
  OTHER
}

model User {
  id                    String                @id @default(cuid())
  email                 String?               @unique @db.VarChar(191)
  phone                 String?               @unique @db.VarChar(20)
  passwordHash          String                @db.VarChar(191)
  firstName             String?               @db.VarChar(100)
  lastName              String?               @db.VarChar(100)
  nationalId            String?               @unique @db.VarChar(20)
  role                  UserRole              @default(CUSTOMER)
  status                UserStatus            @default(ACTIVE)
  emailVerifiedAt       DateTime?
  lastLoginAt           DateTime?
  isGuest               Boolean               @default(false)
  smsMarketingConsent   Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  addresses             Address[]
  orders                Order[]
  cart                  Cart?
  sessions              Session[]
  auditLogs             AuditLog[]            @relation("AuditActor")
  promotionRedemptions  PromotionRedemption[]
  promotionRewards      PromotionReward[]
  productReviews        ProductReview[]       @relation("ProductReviewAuthor")
  moderatedReviews      ProductReview[]       @relation("ProductReviewModerator")
  productReviewVotes    ProductReviewVote[]
  productReviewReports  ProductReviewReport[] @relation("ProductReviewReporter")
  resolvedReviewReports ProductReviewReport[] @relation("ProductReviewReportResolver")
  productFavorites      ProductFavorite[]
  productVisits         ProductVisit[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum PhoneOtpPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
}

// Keyed by phone rather than userId: a REGISTER-purpose code is issued before any User row
// exists, so there is nothing to attach a foreign key to yet. LOGIN/RESET_PASSWORD codes are
// looked up the same way for consistency.
model PhoneOtpCode {
  id         String          @id @default(cuid())
  phone      String          @db.VarChar(20)
  purpose    PhoneOtpPurpose
  codeHash   String          @db.Char(64)
  expiresAt  DateTime
  attempts   Int             @default(0)
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

model AuthRateLimit {
  keyHash         String    @id @db.Char(64)
  attempts        Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model Address {
  id                  String               @id @default(cuid())
  userId              String
  type                AddressType          @default(SHIPPING)
  title               String               @db.VarChar(100)
  recipient           String               @db.VarChar(150)
  recipientType       AddressRecipientType @default(SELF)
  recipientNationalId String?              @db.VarChar(20)
  phone               String               @db.VarChar(20)
  province            String               @db.VarChar(100)
  provinceId          String?
  city                String               @db.VarChar(100)
  cityId              String?
  postalCode          String               @db.VarChar(20)
  addressLine         String               @db.Text
  plaque              String?              @db.VarChar(20)
  unit                String?              @db.VarChar(20)
  floor               String?              @db.VarChar(20)
  latitude            Decimal?             @db.Decimal(10, 7)
  longitude           Decimal?             @db.Decimal(10, 7)
  isDefault           Boolean              @default(false)
  lastUsedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provinceRef         Province?            @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  cityRef             City?                @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isDefault])
  @@index([provinceId])
  @@index([cityId])
}

model Province {
  id              String             @id @default(cuid())
  externalId      Int
  name            String             @db.VarChar(100)
  slug            String             @db.VarChar(120)
  latitude        Decimal?           @db.Decimal(10, 7)
  longitude       Decimal?           @db.Decimal(10, 7)
  source          String             @default("IRAN_POST_GITHUB") @db.VarChar(50)
  sourceUpdatedAt DateTime
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  cities          City[]
  storeOrigins    StoreSetting[]     @relation("StoreOriginProvince")
  shippingZones   ShippingZoneRate[]
  addresses       Address[]

  @@unique([source, externalId])
  @@index([isActive, name])
}

model City {
  id              String         @id @default(cuid())
  externalId      Int
  provinceId      String
  name            String         @db.VarChar(120)
  slug            String         @db.VarChar(140)
  latitude        Decimal?       @db.Decimal(10, 7)
  longitude       Decimal?       @db.Decimal(10, 7)
  source          String         @default("IRAN_POST_GITHUB") @db.VarChar(50)
  sourceUpdatedAt DateTime
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  province        Province       @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  addresses       Address[]
  storeOrigins    StoreSetting[] @relation("StoreOriginCity")

  @@unique([source, externalId])
  @@index([provinceId, isActive, name])
}

/// A delivery option the customer can pick at checkout.
///
/// `source` decides where its price comes from: TAPIN asks the carrier for a live rate, TABLE
/// reads the zone rows below. A TAPIN method keeps zone rows too — they are what answers when
/// the rate service is unreachable, so a checkout never stalls on someone else's downtime.
model ShippingMethod {
  id            String             @id @default(cuid())
  title         String             @db.VarChar(100)
  carrier       String             @db.VarChar(40)
  rateType      String?            @db.VarChar(40)
  source        String             @default("TABLE") @db.VarChar(20)
  orderType     Int                @default(1)
  estimatedDays Int                @default(3)
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  zones         ShippingZoneRate[]
  orders        Order[]

  @@index([isActive, sortOrder])
}

/// One price bracket: parcels up to `maxWeightGrams` going to `provinceId` cost `price`.
/// A null province is the catch-all, used when no province-specific row matches.
model ShippingZoneRate {
  id             String         @id @default(cuid())
  methodId       String
  provinceId     String?
  maxWeightGrams Int
  price          Decimal        @db.Decimal(18, 0)
  createdAt      DateTime       @default(now())
  method         ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  province       Province?      @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@index([methodId, provinceId, maxWeightGrams])
}

model Category {
  id              String      @id @default(cuid())
  name            String      @db.VarChar(100)
  slug            String      @unique @db.VarChar(120)
  description     String?     @db.Text
  parentId        String?
  imageId         String?
  isActive        Boolean     @default(true)
  featured        Boolean     @default(false)
  sortOrder       Int         @default(0)
  attributeSchema Json?
  parent          Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]  @relation("CategoryTree")
  image           MediaAsset? @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  products        Product[]

  @@index([parentId])
  @@index([imageId])
  @@index([isActive, featured, sortOrder])
}

/// A kind of variation the shop sells in — رنگ, سایز — defined once and reused by every product,
/// the same way `Color` already is.
model OptionType {
  id        String              @id @default(cuid())
  name      String              @unique @db.VarChar(80)
  kind      OptionKind          @default(SELECT)
  isActive  Boolean             @default(true)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  values    OptionValue[]
  products  ProductOptionType[] @relation("ProductOptionType")

  @@index([isActive, sortOrder, name])
}

/// One choice inside a type. A COLOR type points its values at the `Color` library rather than
/// naming a colour twice.
model OptionValue {
  id        String               @id @default(cuid())
  typeId    String
  label     String               @db.VarChar(80)
  colorId   String?
  isActive  Boolean              @default(true)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  type      OptionType           @relation(fields: [typeId], references: [id], onDelete: Cascade)
  color     Color?               @relation(fields: [colorId], references: [id], onDelete: SetNull)
  products  ProductOptionValue[]

  @@unique([typeId, label])
  @@index([typeId, isActive, sortOrder])
}

model Color {
  id           String        @id @default(cuid())
  name         String        @unique @db.VarChar(100)
  hex          String        @db.Char(7)
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  optionValues OptionValue[]

  @@index([isActive, sortOrder, name])
}

model Product {
  id                  String               @id @default(cuid())
  sku                 String               @unique @db.VarChar(80)
  name                String               @db.VarChar(191)
  slug                String               @unique @db.VarChar(191)
  description         String?              @db.LongText
  status              ProductStatus        @default(DRAFT)
  storeIndustry       StoreIndustry        @default(GOLD)
  categoryId          String?
  brandId             String?
  optionGuideId       String?
  purity              Int                  @default(750)
  weightGrams         Decimal              @db.Decimal(10, 3)
  makingFeeType       String               @default("PERCENT") @db.VarChar(20)
  makingFeeValue      Decimal              @default(0) @db.Decimal(15, 3)
  profitPercent       Decimal              @default(7) @db.Decimal(5, 2)
  taxPercent          Decimal              @default(10) @db.Decimal(5, 2)
  fixedPrice          Decimal?             @db.Decimal(18, 0)
  discountType        ProductDiscountType?
  discountValue       Decimal?             @db.Decimal(18, 3)
  discountStartsAt    DateTime?
  discountEndsAt      DateTime?
  stock               Int                  @default(0)
  preparationDays     Int                  @default(2)
  // Packaged figures for shipping, kept apart from `weightGrams`, which is the gold weight the
  // price is built from. Null means "not measured yet", so a carrier quote can say so.
  shippingWeightGrams Int?
  packageLengthCm     Decimal?             @db.Decimal(8, 2)
  packageWidthCm      Decimal?             @db.Decimal(8, 2)
  packageHeightCm     Decimal?             @db.Decimal(8, 2)
  // Per-product order limits. The store-wide cap in order settings still applies on top.
  minOrderQuantity    Int                  @default(1)
  maxOrderQuantity    Int?
  featured            Boolean              @default(false)
  attributes          Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand               Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  optionGuide         MediaAsset?          @relation("ProductOptionGuide", fields: [optionGuideId], references: [id], onDelete: SetNull)
  optionTypes         ProductOptionType[]
  variants            ProductVariant[]
  media               ProductMedia[]
  orderItems          OrderItem[]
  cartItems           CartItem[]
  reviews             ProductReview[]
  favorites           ProductFavorite[]
  visits              ProductVisit[]

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([optionGuideId])
  @@index([featured, status])
  @@index([discountEndsAt])
}

/// A product's manufacturer — Samsung, Xiaomi, … — shown as its own logo strip on the homepage
/// and filterable on the catalogue, the same role `Category` plays for grouping.
model Brand {
  id        String      @id @default(cuid())
  name      String      @db.VarChar(100)
  slug      String      @unique @db.VarChar(120)
  logoId    String?
  isActive  Boolean     @default(true)
  /// Shown in the homepage's "محبوب‌ترین برندها" carousel — same role `Product.featured` and
  /// `Category.featured` already play for their own homepage sections.
  featured  Boolean     @default(false)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  logo      MediaAsset? @relation("ProductBrandLogo", fields: [logoId], references: [id], onDelete: SetNull)
  products  Product[]

  @@index([logoId])
  @@index([isActive, featured, sortOrder])
}

model ProductReview {
  id                 String                @id @default(cuid())
  productId          String
  userId             String
  parentId           String?
  rating             Int?
  title              String?               @db.VarChar(120)
  body               String                @db.Text
  status             ProductReviewStatus   @default(PENDING)
  isVerifiedPurchase Boolean               @default(false)
  moderatedById      String?
  moderatedAt        DateTime?
  moderationNote     String?               @db.VarChar(500)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  product            Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User                  @relation("ProductReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  parent             ProductReview?        @relation("ProductReviewThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies            ProductReview[]       @relation("ProductReviewThread")
  moderatedBy        User?                 @relation("ProductReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  votes              ProductReviewVote[]
  reports            ProductReviewReport[]

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([parentId, status, createdAt])
  @@index([moderatedById])
}

model ProductReviewVote {
  id        String        @id @default(cuid())
  reviewId  String
  userId    String
  value     Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId, createdAt])
}

model ProductReviewReport {
  id           String                    @id @default(cuid())
  reviewId     String
  userId       String
  reason       String                    @db.VarChar(50)
  details      String?                   @db.VarChar(500)
  status       ProductReviewReportStatus @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  review       ProductReview             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user         User                      @relation("ProductReviewReporter", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy   User?                     @relation("ProductReviewReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reviewId, userId])
  @@index([status, createdAt])
  @@index([resolvedById])
}

model ProductFavorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model ProductVisit {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  visitCount Int      @default(1)
  visitedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, visitedAt])
  @@index([productId])
}

model StoreSetting {
  id                            String                @id @default("main") @db.VarChar(20)
  industry                      StoreIndustry         @default(GOLD)
  storeName                     String                @default("زر گالری") @db.VarChar(120)
  tagline                       String                @default("طلا، روایت ماندگار شما") @db.VarChar(191)
  shortDescription              String                @default("فروش آنلاین زیورآلات طلای ۱۸ عیار با قیمت روز و فاکتور رسمی") @db.VarChar(500)
  currency                      String                @default("IRR") @db.VarChar(3)
  timezone                      String                @default("Asia/Tehran") @db.VarChar(50)
  supportPhone                  String?               @db.VarChar(30)
  supportEmail                  String?               @db.VarChar(191)
  storeAddress                  String?               @db.Text
  legalIdentifier               String?               @db.VarChar(80)
  supportHours                  String?               @db.VarChar(191)
  isStoreActive                 Boolean               @default(true)
  guestCheckout                 Boolean               @default(true)
  maintenanceMode               Boolean               @default(false)
  defaultShippingFee            Decimal               @default(0) @db.Decimal(18, 0)
  // Where parcels ship from. A carrier quote needs an origin, and the store has only ever had a
  // free-text address, which no rate API can read.
  originProvinceId              String?
  originCityId                  String?
  // Used when a product carries no packaged weight, so the cart is never left without a price.
  defaultParcelWeightGrams      Int                   @default(500)
  homepageSections              Json?
  menuCategoryIds               Json?
  homepageTreasureCards         Json?
  homepageTileGroups            Json?
  homepageHeroSlides            Json?
  homepageLicenses              Json?
  generalHomepageSettings       Json?
  heroContentMode               String                @default("WITH_CONTENT") @db.VarChar(20)
  heroTitle                     String                @default("درخشش ماندگار، انتخابی مطمئن") @db.VarChar(191)
  heroDescription               String                @default("جدیدترین زیورآلات طلا با قیمت لحظه‌ای") @db.VarChar(500)
  heroButtonLabel               String                @default("مشاهده محصولات") @db.VarChar(80)
  heroButtonHref                String                @default("/products") @db.VarChar(500)
  heroDesktopMediaId            String?
  heroMobileMediaId             String?
  promoBannerEnabled            Boolean               @default(false)
  promoBannerHref               String?               @db.VarChar(500)
  promoDesktopMediaId           String?
  promoMobileMediaId            String?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  heroDesktopMedia              MediaAsset?           @relation("HomepageHeroDesktop", fields: [heroDesktopMediaId], references: [id], onDelete: SetNull)
  heroMobileMedia               MediaAsset?           @relation("HomepageHeroMobile", fields: [heroMobileMediaId], references: [id], onDelete: SetNull)
  promoDesktopMedia             MediaAsset?           @relation("HomepagePromoDesktop", fields: [promoDesktopMediaId], references: [id], onDelete: SetNull)
  promoMobileMedia              MediaAsset?           @relation("HomepagePromoMobile", fields: [promoMobileMediaId], references: [id], onDelete: SetNull)
  brandPrimaryColor             String                @default("#1C3155") @db.VarChar(7)
  brandAccentColor              String                @default("#B5904C") @db.VarChar(7)
  brandBackgroundColor          String                @default("#F7F6F3") @db.VarChar(7)
  brandDangerColor              String                @default("#B8423A") @db.VarChar(7)
  adminTemplate                 AdminTemplate         @default(CLASSIC)
  originProvince                Province?             @relation("StoreOriginProvince", fields: [originProvinceId], references: [id], onDelete: SetNull)
  originCity                    City?                 @relation("StoreOriginCity", fields: [originCityId], references: [id], onDelete: SetNull)
  enforceColorContrast          Boolean               @default(true)
  stickyStoreHeader             Boolean               @default(true)
  compactMobileGrid             Boolean               @default(true)
  liveGoldPrice                 Boolean               @default(true)
  mainLogoMediaId               String?
  darkLogoMediaId               String?
  faviconMediaId                String?
  socialImageMediaId            String?
  mainLogoMedia                 MediaAsset?           @relation("BrandMainLogo", fields: [mainLogoMediaId], references: [id], onDelete: SetNull)
  darkLogoMedia                 MediaAsset?           @relation("BrandDarkLogo", fields: [darkLogoMediaId], references: [id], onDelete: SetNull)
  faviconMedia                  MediaAsset?           @relation("BrandFavicon", fields: [faviconMediaId], references: [id], onDelete: SetNull)
  socialImageMedia              MediaAsset?           @relation("BrandSocialImage", fields: [socialImageMediaId], references: [id], onDelete: SetNull)
  orderExpirationEnabled        Boolean               @default(true)
  orderExpirationMinutes        Int                   @default(15)
  orderWarningMinutes           Int                   @default(5)
  orderExpirationStart          OrderExpirationStart  @default(CREATED_AT)
  orderExpirationAction         OrderExpirationAction @default(EXPIRE)
  showOrderCountdown            Boolean               @default(true)
  releaseReservedInventory      Boolean               @default(true)
  restorePromotionOnExpiry      Boolean               @default(true)
  minimumOrderAmount            Decimal               @default(5000000) @db.Decimal(18, 0)
  orderNumberPrefix             String                @default("ZG") @db.VarChar(10)
  maxOrderItemQuantity          Int                   @default(5)
  revalidateGoldAtCheckout      Boolean               @default(true)
  onlinePaymentEnabled          Boolean               @default(true)
  freeShippingThreshold         Decimal?              @default(100000000) @db.Decimal(18, 0)
  preparationDays               Int                   @default(2)
  insuredShippingEnabled        Boolean               @default(true)
  inStorePickupEnabled          Boolean               @default(true)
  calculateShippingAfterAddress Boolean               @default(true)
  catalogLowStockThreshold      Int                   @default(3)
  catalogPageSize               Int                   @default(24)
  hideOutOfStockProducts        Boolean               @default(true)
  showProductStock              Boolean               @default(true)
  goldPriceRefreshSeconds       Int                   @default(60)
  goldPriceCacheSeconds         Int                   @default(120)
  goldPriceFallbackMinutes      Int                   @default(15)
  faqItems                      Json?
  contentPages                  Json?

  @@index([heroDesktopMediaId])
  @@index([heroMobileMediaId])
  @@index([promoDesktopMediaId])
  @@index([promoMobileMediaId])
  @@index([mainLogoMediaId])
  @@index([darkLogoMediaId])
  @@index([faviconMediaId])
  @@index([socialImageMediaId])
}

model Promotion {
  id                String                 @id @default(cuid())
  title             String                 @db.VarChar(191)
  type              PromotionType
  code              String?                @unique @db.VarChar(64)
  discountType      PromotionDiscountType?
  discountValue     Decimal?               @db.Decimal(18, 3)
  minOrderAmount    Decimal?               @db.Decimal(18, 0)
  maxDiscountAmount Decimal?               @db.Decimal(18, 0)
  usageLimit        Int?
  perUserLimit      Int                    @default(1)
  rewardExpiresDays Int?
  shippingScope     String?                @db.VarChar(30)
  startsAt          DateTime
  endsAt            DateTime
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  redemptions       PromotionRedemption[]
  rewards           PromotionReward[]

  @@index([type, isActive, startsAt, endsAt])
  @@index([isActive, endsAt])
}

model PromotionRedemption {
  id               String    @id @default(cuid())
  promotionId      String
  userId           String
  orderId          String
  discountAmount   Decimal   @default(0) @db.Decimal(18, 0)
  shippingDiscount Decimal   @default(0) @db.Decimal(18, 0)
  snapshot         Json
  createdAt        DateTime  @default(now())
  promotion        Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([promotionId, orderId])
  @@index([promotionId, userId, createdAt])
  @@index([orderId])
}

model PromotionReward {
  id                String                @id @default(cuid())
  promotionId       String
  userId            String
  sourceOrderId     String
  redeemedOrderId   String?
  discountType      PromotionDiscountType
  discountValue     Decimal               @db.Decimal(18, 3)
  maxDiscountAmount Decimal?              @db.Decimal(18, 0)
  expiresAt         DateTime
  redeemedAt        DateTime?
  createdAt         DateTime              @default(now())
  promotion         Promotion             @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceOrder       Order                 @relation("PromotionRewardSource", fields: [sourceOrderId], references: [id], onDelete: Restrict)
  redeemedOrder     Order?                @relation("PromotionRewardRedemption", fields: [redeemedOrderId], references: [id], onDelete: SetNull)

  @@unique([promotionId, sourceOrderId])
  @@index([userId, redeemedAt, expiresAt])
  @@index([redeemedOrderId])
}

model MediaAsset {
  id                   String         @id @default(cuid())
  type                 MediaType
  scope                MediaScope     @default(PRODUCT)
  url                  String         @db.Text
  storageKey           String         @unique @db.VarChar(191)
  title                String?        @db.VarChar(191)
  alt                  String?        @db.VarChar(191)
  caption              String?        @db.VarChar(300)
  description          String?        @db.Text
  mimeType             String         @db.VarChar(100)
  sizeBytes            Int
  width                Int?
  height               Int?
  durationSec          Int?
  createdAt            DateTime       @default(now())
  products             ProductMedia[]
  optionGuideProducts  Product[]      @relation("ProductOptionGuide")
  categories           Category[]     @relation("CategoryImage")
  brandLogos           Brand[]        @relation("ProductBrandLogo")
  homepageHeroDesktop  StoreSetting[] @relation("HomepageHeroDesktop")
  homepageHeroMobile   StoreSetting[] @relation("HomepageHeroMobile")
  homepagePromoDesktop StoreSetting[] @relation("HomepagePromoDesktop")
  homepagePromoMobile  StoreSetting[] @relation("HomepagePromoMobile")
  brandMainLogo        StoreSetting[] @relation("BrandMainLogo")
  brandDarkLogo        StoreSetting[] @relation("BrandDarkLogo")
  brandFavicon         StoreSetting[] @relation("BrandFavicon")
  brandSocialImage     StoreSetting[] @relation("BrandSocialImage")

  @@index([scope, createdAt])
  @@index([scope, type, createdAt])
}

/// Which types a product varies by.
model ProductOptionType {
  productId String
  typeId    String
  position  Int                  @default(0)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      OptionType           @relation("ProductOptionType", fields: [typeId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@id([productId, typeId])
  @@index([productId, position])
}

/// Which of a type's values this product offers. A real row rather than a list of ids, so the
/// catalogue can join straight through to `OptionValue.color` and filter by it.
model ProductOptionValue {
  productId  String
  typeId     String
  valueId    String
  position   Int               @default(0)
  optionType ProductOptionType @relation(fields: [productId, typeId], references: [productId, typeId], onDelete: Cascade)
  value      OptionValue       @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([productId, typeId, valueId])
  @@index([valueId])
}

/// One buyable combination — «مشکی، XL» — with its own price, discount and stock.
///
/// `selectionKey` is the same SHA-256 of the ordered selection that `CartItem` already stores, so
/// a line in the cart finds its combination without a second identifier.
model ProductVariant {
  id               String               @id @default(cuid())
  productId        String
  selectionKey     String               @db.VarChar(64)
  /// Readable snapshot for the cart and the invoice: { "رنگ": "مشکی", "سایز": "XL" }.
  selection        Json
  /// General shops price a combination directly; gold shops give it a weight and the day's rate
  /// builds the price. Only one of the two is ever set.
  price            Decimal?             @db.Decimal(18, 0)
  weightGrams      Decimal?             @db.Decimal(10, 3)
  /// Overrides the product's discount for this combination, window included; a combination with
  /// no discount of its own falls back to the product's, exactly as the type and amount already did.
  discountType     ProductDiscountType?
  discountValue    Decimal?             @db.Decimal(18, 3)
  discountStartsAt DateTime?
  discountEndsAt   DateTime?
  stock            Int                  @default(0)
  isActive         Boolean              @default(true)
  /// Optimistic lock, as `ProductOption.stockVersion` was: a concurrent order must not overwrite
  /// a stock read it made before the other one landed.
  stockVersion     Int                  @default(0)
  createdAt        DateTime             @default(now())
  product          Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, selectionKey])
  @@index([productId, isActive])
  @@index([discountEndsAt])
}

model ProductMedia {
  productId String
  mediaId   String
  position  Int        @default(0)
  isCover   Boolean    @default(false)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([productId, position])
}

model GoldPrice {
  id             String   @id @default(cuid())
  pricePerGram18 Decimal  @db.Decimal(18, 0)
  currency       String   @default("IRR") @db.VarChar(3)
  source         String   @db.VarChar(100)
  fetchedAt      DateTime
  createdAt      DateTime @default(now())

  @@index([fetchedAt])
}

model PaymentGatewayConfig {
  id                  String   @id @default(cuid())
  provider            String   @unique @db.VarChar(40)
  displayName         String   @db.VarChar(100)
  credentialEncrypted String   @db.Text
  credentialMasked    String   @db.VarChar(80)
  isSandbox           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([updatedAt])
}

model SmsProviderConfig {
  id                   String   @id @default(cuid())
  provider             String   @unique @db.VarChar(40)
  displayName          String   @db.VarChar(100)
  credentialsEncrypted String   @db.Text
  credentialMasked     String   @db.VarChar(80)
  senderNumber         String   @db.VarChar(40)
  isActive             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive, updatedAt])
}

model CommunicationSetting {
  id                String   @id @default("main")
  smsEnabled        Boolean  @default(false)
  inAppEnabled      Boolean  @default(true)
  adminPhone        String?  @db.VarChar(20)
  orderCreatedSms   Boolean  @default(false)
  paymentSuccessSms Boolean  @default(true)
  orderShippedSms   Boolean  @default(true)
  orderExpiredSms   Boolean  @default(false)
  lowStockAdminSms  Boolean  @default(false)
  templates         Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SmsCampaign {
  id              String   @id @default(cuid())
  actorId         String?  @db.VarChar(191)
  provider        String   @db.VarChar(40)
  audience        String   @db.VarChar(50)
  message         String   @db.Text
  recipientCount  Int      @default(0)
  successfulCount Int      @default(0)
  failedCount     Int      @default(0)
  status          String   @db.VarChar(30)
  providerData    Json?
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id              String  @id @default(cuid())
  cartId          String
  productId       String
  selectionKey    String  @default("") @db.VarChar(64)
  selectedOptions Json?
  quantity        Int     @default(1)
  cart            Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, selectionKey])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                       String                @id @default(cuid())
  orderNumber              String                @unique @db.VarChar(40)
  userId                   String
  status                   OrderStatus           @default(PENDING_PAYMENT)
  goldPriceSnapshot        Decimal               @db.Decimal(18, 0)
  subtotal                 Decimal               @db.Decimal(18, 0)
  discount                 Decimal               @default(0) @db.Decimal(18, 0)
  productDiscount          Decimal               @default(0) @db.Decimal(18, 0)
  promotionDiscount        Decimal               @default(0) @db.Decimal(18, 0)
  shipping                 Decimal               @default(0) @db.Decimal(18, 0)
  shippingDiscount         Decimal               @default(0) @db.Decimal(18, 0)
  shippingMethodId         String?
  // Snapshot: the method may be renamed or removed, and a past invoice must not change with it.
  shippingMethodTitle      String?               @db.VarChar(100)
  tax                      Decimal               @default(0) @db.Decimal(18, 0)
  total                    Decimal               @db.Decimal(18, 0)
  shippingAddress          Json
  notes                    String?               @db.Text
  expiresAt                DateTime?
  expiredAt                DateTime?
  expirationHandledAt      DateTime?
  deliveryMethod           DeliveryMethod        @default(INSURED_SHIPPING)
  shippingMethod           ShippingMethod?       @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  trackingNumber           String?               @db.VarChar(100)
  preparationDaysSnapshot  Int                   @default(2)
  estimatedReadyAt         DateTime?
  inventoryReserved        Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  user                     User                  @relation(fields: [userId], references: [id])
  items                    OrderItem[]
  payments                 Payment[]
  invoice                  Invoice?
  promotionRedemptions     PromotionRedemption[]
  issuedPromotionRewards   PromotionReward[]     @relation("PromotionRewardSource")
  redeemedPromotionRewards PromotionReward[]     @relation("PromotionRewardRedemption")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, expiresAt])
}

model OrderItem {
  id                String        @id @default(cuid())
  orderId           String
  productId         String?
  sku               String        @db.VarChar(80)
  name              String        @db.VarChar(191)
  selectedOptions   Json?
  /// The combination this line bought, so releasing it can find the row to give stock back to.
  /// Empty for a product sold without variants.
  selectionKey      String        @default("") @db.VarChar(64)
  storeIndustry     StoreIndustry @default(GOLD)
  quantity          Int
  weightGrams       Decimal       @db.Decimal(10, 3)
  purity            Int
  rawGold           Decimal       @default(0) @db.Decimal(18, 0)
  makingFee         Decimal       @db.Decimal(18, 0)
  profit            Decimal       @db.Decimal(18, 0)
  tax               Decimal       @db.Decimal(18, 0)
  originalUnitPrice Decimal       @default(0) @db.Decimal(18, 0)
  discountAmount    Decimal       @default(0) @db.Decimal(18, 0)
  unitPrice         Decimal       @db.Decimal(18, 0)
  total             Decimal       @db.Decimal(18, 0)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  provider     String        @db.VarChar(50)
  authority    String?       @unique @db.VarChar(191)
  referenceId  String?       @unique @db.VarChar(191)
  amount       Decimal       @db.Decimal(18, 0)
  status       PaymentStatus @default(INITIATED)
  providerData Json?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  order        Order         @relation(fields: [orderId], references: [id])

  @@index([orderId, status])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique @db.VarChar(40)
  orderId       String        @unique
  status        InvoiceStatus @default(ISSUED)
  sellerData    Json
  buyerData     Json
  issuedAt      DateTime      @default(now())
  order         Order         @relation(fields: [orderId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(191)
  metadata   Json?
  ipAddress  String?  @db.VarChar(50)
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model ContactMessage {
  id         String    @id @default(cuid())
  name       String    @db.VarChar(150)
  email      String    @db.VarChar(191)
  phone      String?   @db.VarChar(20)
  subject    String    @db.VarChar(191)
  message    String    @db.Text
  isResolved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([isResolved, createdAt])
}
