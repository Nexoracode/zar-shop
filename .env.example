DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=zar-store
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3003

# Primary provider: tgju, or http for a custom JSON endpoint.
GOLD_PRICE_PROVIDER=tgju
GOLD_PRICE_ENDPOINT=
GOLD_PRICE_API_KEY=

# Fallback providers. Both return toman and are normalized to IRR internally.
NAVASAN_API_KEY=
NAVASAN_API_ENDPOINT=
ARZHAAM_API_KEY=
ARZHAAM_API_ENDPOINT=
GOLD_PRICE_MAX_SOURCE_AGE_MINUTES=180

PAYMENT_PROVIDER=mock
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-password
