NODE_ENV=development
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=store_db
# فقط برای دستور prisma (migrate/generate) لازم است؛ باید با مقادیر بالا هم‌خوان باشد.
# مثال: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql://root:@127.0.0.1:3306/store_db
# فقط روی VPS و برای docker-compose.yml لازم است؛ رمز کاربر root کانتینر دیتابیس، جدا از DATABASE_PASSWORD.
DATABASE_ROOT_PASSWORD=
# فقط روی VPS و برای Caddyfile لازم است؛ دامنه‌ای که سایت روی آن بالا می‌آید.
DOMAIN=

# Minimum 32 characters. Keys session rate-limit HMAC and at-rest credential encryption.
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000

# Primary provider: tgju, or http for a custom JSON endpoint.
GOLD_PRICE_PROVIDER=tgju
GOLD_PRICE_ENDPOINT=
GOLD_PRICE_API_KEY=

# Fallback providers. Both return toman and are normalized to IRR internally.
NAVASAN_API_KEY=
NAVASAN_API_ENDPOINT=
ARZHAAM_API_KEY=
ARZHAAM_API_ENDPOINT=
GOLD_PRICE_MAX_SOURCE_AGE_MINUTES=180

# FTP media storage. Files are stored below zar-shop/categories or zar-shop/products.
FTP_HOST=
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
FTP_SECURE=false
FTP_PUBLIC_BASE_URL=

PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Secret used by GET /api/cron/orders/expire (minimum 32 characters).
CRON_SECRET=

# Seed-only: first admin account created by `npm run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=ChangeMe!123

# Hosted DEMO deployments only (Vercel build, `npm run db:seed:vercel`). Leave both unset on a real store.
# true|general adds the sample general store (gold adds the gold one) when the database has no catalogue yet.
SEED_DEMO_ON_BUILD=
# true also adds sample traffic and orders for the dashboard, refreshed on every build.
SEED_DEMO_TRAFFIC=

ZARINPAL_MERCHANT_ID=bb693923-84f9-4db1-b761-c10921af368c
ZARINPAL_SANDBOX=false
FRONTEND_URL=https://rshop.roohbakhshac.ir
FARAZ_SMS_BASE_URL=https://api.iranpayamak.com
FARAZ_SMS_API_KEY=NeH5zYaSTIfHERU6IwaiCmMv0KR5ZeeRBwbCPdrlJ6gGgQZRd9
FARAZ_SMS_ORIGINATOR=90008361
