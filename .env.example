NODE_ENV=development
DATABASE_URL=mysql://root:password@127.0.0.1:3306/store_db
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=store_db
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000

# Primary provider: tgju, or http for a custom JSON endpoint.
GOLD_PRICE_PROVIDER=tgju
GOLD_PRICE_ENDPOINT=
GOLD_PRICE_API_KEY=

# Fallback providers. Both return toman and are normalized to IRR internally.
NAVASAN_API_KEY=
NAVASAN_API_ENDPOINT=
ARZHAAM_API_KEY=
ARZHAAM_API_ENDPOINT=
GOLD_PRICE_MAX_SOURCE_AGE_MINUTES=180

# FTP media storage. Files are stored below zar-shop/categories or zar-shop/products.
FTP_HOST=
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
FTP_SECURE=false
FTP_PUBLIC_BASE_URL=https://cdn.example.com

PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Secret used by GET /api/cron/orders/expire (minimum 32 characters).
CRON_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-password
